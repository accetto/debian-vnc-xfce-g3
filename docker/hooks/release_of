#!/bin/bash

main() {
    local result=""
    local response=""

    local subject=${1:?'Subject must be provided as the first parameter!'}

    ### Warning! The log name must be synchronized with the 'builder.sh' script!
    local curl_output="scrap_release_of.log"

    case "${subject}" in

        brave )
            if [[ -n "${RELEASE_OF_OVERRIDE_brave}" ]] ; then
                result="${RELEASE_OF_OVERRIDE_brave}"
                echo "Using forced RELEASE_OF_OVERRIDE_brave=${result}" >&2
            else
                response=$(curl -sLN https://api.github.com/repos/brave/brave-browser/releases/latest)

                if [[ -n "${response}" ]] ; then
                    result=$( echo "${response}" | grep -m1 "tag_name" | grep -Po '[0-9.]+' )
                fi
            fi
            ;;

        chromium|chromium-trixie )
            if [[ -n "${RELEASE_OF_OVERRIDE_chromium_trixie}" ]] ; then
                result="${RELEASE_OF_OVERRIDE_chromium_trixie}"
                echo "Using forced RELEASE_OF_OVERRIDE_chromium_trixie=${result}" >&2
            else
                response=$(curl -sLN 	https://packages.debian.org/search?keywords=chromium&searchon=names&suite=trixie&section=main)

                if [[ -n "${response}" ]] ; then
                    result=$( echo "${response}" | grep -P -m1 -A10 '(?<=class="trixie")' | grep -Po -m1 '(?<=\<br\>)[0-9a-z.-]+~[0-9a-z]+' )
                fi
            fi
            ;;

        chromium-bookworm )
            if [[ -n "${RELEASE_OF_OVERRIDE_chromium_bookworm}" ]] ; then
                result="${RELEASE_OF_OVERRIDE_chromium_bookworm}"
                echo "Using forced RELEASE_OF_OVERRIDE_chromium_bookworm=${result}" >&2
            else
                response=$(curl -sLN 	https://packages.debian.org/search?keywords=chromium&searchon=names&suite=bookworm&section=main)

                if [[ -n "${response}" ]] ; then
                    result=$( echo "${response}" | grep -P -m1 -A10 '(?<=class="bookworm")' | grep -Po -m1 '(?<=\<br\>)[0-9a-z.-]+~[0-9a-z]+' )
                fi
            fi
            ;;

        firefox|firefox-trixie )
            if [[ -n "${RELEASE_OF_OVERRIDE_firefox_trixie}" ]] ; then
                result="${RELEASE_OF_OVERRIDE_firefox_trixie}"
                echo "Using forced RELEASE_OF_OVERRIDE_firefox_trixie=${result}" >&2
            else
                response=$(curl -sLN 	https://packages.debian.org/search?keywords=firefox-esr&searchon=names&suite=trixie&section=main)

                if [[ -n "${response}" ]] ; then
                    result=$( echo "${response}" | grep -P -m1 -A10 '(?<=class="trixie")' | grep -Po -m1 '(?<=\<br\>)[0-9a-z.-]+~[0-9a-z]+' )
                fi
            fi
            ;;

        firefox-bookworm )
            if [[ -n "${RELEASE_OF_OVERRIDE_firefox_bookworm}" ]] ; then
                result="${RELEASE_OF_OVERRIDE_firefox_bookworm}"
                echo "Using forced RELEASE_OF_OVERRIDE_firefox_bookworm=${result}" >&2
            else
                response=$(curl -sLN https://packages.debian.org/search?keywords=firefox-esr&searchon=names&suite=bookworm&section=main)

                if [[ -n "${response}" ]] ; then
                    result=$( echo "${response}" | grep -P -m1 -A10 '(?<=class="bookworm")' | grep -Po -m1 '(?<=\<br\>)[0-9a-z.-]+~[0-9a-z]+' )
                fi
            fi
            ;;
        
        * )
            echo "Exiting '${0}' with code '1' because of unknown subject '${1}'"
            return 1
            ;;

    esac

    if [[ -n "${result}" ]] ; then

        echo "${result}"
    else
        ### log the unexpected 'curl' response into the log file
        echo -e "\n==> EXECUTING @$(date -u +'%Y-%m-%d_%H-%M-%S'): ${0} $@\n\n${response}\n" >> "${curl_output}"

        echo "ERROR: Exiting '${0}' with code '1' because unable to get version of '${subject}'"
        echo "ERROR: Unexpected HTTPS response (see the file '${curl_output}')"
        
        return 1
    fi
}

main $@
